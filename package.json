{
  "name": "specpilot",
  "version": "0.1.0-dev",
  "description": "AI coding agents that work from specs, and get tested and measured before you trust them.",
  "license": "MIT",
  "bin": {
    "specpilot": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run build && jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts"
    ]
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "18.19.130",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "typescript": "6.0.3"
  }
}
